MILKDROP_PRESET_VERSION=201
PSVERSION=2
[preset00]
fRating=3.000000
fDecay=0.900000
fGammaAdj=1.500000
nWaveMode=0
bAdditiveWaves=1
fWaveAlpha=1.000000
fWaveScale=1.500000
zoom=1.020000
rot=0.010000
wave_r=1.000000
wave_g=0.600000
wave_b=0.200000
ob_size=0.020000
ob_a=0.000000
wavecode_0_enabled=1
wavecode_0_samples=256
wavecode_0_bDrawThick=1
wavecode_0_r=0.300000
wavecode_0_g=0.800000
wavecode_0_b=1.000000
wave_0_per_point1=x = sample;
wave_0_per_point2=y = 0.5 + 0.25*value1 + 0.1*sin(sample*12 + time*3);
shapecode_0_enabled=1
shapecode_0_sides=5
shapecode_0_rad=0.180000
shapecode_0_r=1.000000
shapecode_0_g=0.900000
shapecode_0_b=0.400000
shapecode_0_a=0.900000
shape_0_init1=t1 = 0;
shape_0_per_frame1=x = 0.5 + 0.3*sin(time*0.9);
shape_0_per_frame2=y = 0.5 + 0.25*cos(time*1.3);
shape_0_per_frame3=ang = time;
per_frame_init_1=q1 = 0;
per_frame_1=// Bilerek parlar: saniyede dört kez tersine döner (yalnızca test).
per_frame_2=invert = above(sin(time*25.1327), 0);
per_frame_3=zoom = zoom + 0.02*bass;
per_pixel_1=rot = rot + 0.03*rad;
