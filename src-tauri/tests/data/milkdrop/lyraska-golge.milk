MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
fRating=3.000000
fDecay=0.950000
fGammaAdj=1.000000
nWaveMode=0
bAdditiveWaves=1
fWaveAlpha=1.000000
fWaveScale=1.500000
zoom=1.010000
rot=0.000000
wave_r=1.000000
wave_g=0.700000
wave_b=0.300000
ob_size=0.000000
wavecode_0_enabled=1
wavecode_0_samples=256
wavecode_0_bDrawThick=1
wavecode_0_r=0.400000
wavecode_0_g=0.900000
wavecode_0_b=1.000000
wave_0_per_point1=x = sample;
wave_0_per_point2=y = 0.5 + 0.25*value1 + 0.12*sin(sample*10 + time*2);
shapecode_0_enabled=1
shapecode_0_sides=6
shapecode_0_rad=0.150000
shapecode_0_r=0.900000
shapecode_0_g=0.500000
shapecode_0_b=1.000000
shapecode_0_a=0.800000
shape_0_per_frame1=x = 0.5 + 0.3*sin(time*0.8);
shape_0_per_frame2=y = 0.5 + 0.2*cos(time*1.1);
per_frame_init_1=q1 = 0;
per_frame_1=// Lyraska'nın gölgelendirici denemesi (yalnızca test): birleştirme saniyede dört kez parlar.
per_frame_2=q1 = 0.5 + 0.5*sin(time*0.7);
warp_1=`// Bükme: önceki kare dalgalanarak akar (hareket), bulanıklık ve gürültü eklenir.
warp_2=`float2 swirl(float2 p, float t)
warp_3=`{
warp_4=`    return float2(sin(t*1.7 + p.y*9), cos(t*1.3 + p.x*9));
warp_5=`}
warp_6=`shader_body
warp_7=`{
warp_8=`    float2 d = uv - 0.5;
warp_9=`    float2 w = uv + 0.003*swirl(d, time)*(1 + q1) - 0.004*d;
warp_10=`    ret = tex2D(sampler_main, w).xyz*0.95 + 0.03*GetBlur1(uv);
warp_11=`    ret += (tex2D(sampler_noise_lq, uv*texsize.xy*texsize_noise_lq.zw).xyz - 0.5)*0.01;
warp_12=`    ret *= 1 - 0.05*rad;
warp_13=`}
comp_1=`// Birleştirme: sol yarı saniyede dört kez beyaza çakar (bilerek parlar); sağ yarı görüntü.
comp_2=`shader_body
comp_3=`{
comp_4=`    float3 base = GetPixel(uv) + 0.3*GetBlur1(uv);
comp_5=`    float strobe = step(0.5, frac(time*4.0))*step(uv.x, 0.5);
comp_6=`    ret = lerp(base, float3(1, 1, 1), strobe);
comp_7=`    ret *= 0.9 + 0.1*lum(hue_shader) + 0.0*rand_frame.x;
comp_8=`}
