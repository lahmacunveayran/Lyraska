+//! Denetim aracı (B-SES): bir dosyayı Lyraska'nın çözücüsüyle çözer, örnekleri f64 LE olarak yazar.
+//!
+//! Kullanım: denetim_coz <dosya> <çıktı.f64> [sarma_saniye]
+//! stdout'a tek satır JSON: hız, kanal, süre, sarmada inilen kare, yazılan kare sayısı.
+#![allow(clippy::unwrap_used, clippy::expect_used)]
+
+use std::io::Write;
+use std::path::Path;
+
+use lyraska_lib::audio::decode::Decoder;
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let input = Path::new(&args[1]);
+    let output = &args[2];
+    let seek: Option<f64> = args.get(3).map(|s| s.parse().unwrap());
+    let mut decoder = match Decoder::open(input) {
+        Ok(d) => d,
+        Err(e) => {
+            println!("{{\"error\":\"{e}\"}}");
+            return;
+        }
+    };
+    let info = decoder.info().clone();
+    let landed = match seek {
+        Some(secs) => match decoder.seek(secs) {
+            Ok(frame) => frame as i64,
+            Err(e) => {
+                println!(
+                    "{{\"error\":\"sarma: {e}\",\"sampleRate\":{},\"channels\":{},\"duration\":{}}}",
+                    info.sample_rate,
+                    info.channels,
+                    info.duration_secs.unwrap_or(-1.0)
+                );
+                return;
+            }
+        },
+        None => -1,
+    };
+    let mut file = std::io::BufWriter::new(std::fs::File::create(output).unwrap());
+    let mut frames = 0u64;
+    let mut chunks = 0u64;
+    loop {
+        match decoder.next_chunk() {
+            Ok(Some(chunk)) => {
+                for s in chunk {
+                    file.write_all(&s.to_le_bytes()).unwrap();
+                }
+                frames += (chunk.len() / info.channels) as u64;
+                chunks += 1;
+            }
+            Ok(None) => break,
+            Err(e) => {
+                println!("{{\"error\":\"çözme: {e}\"}}");
+                return;
+            }
+        }
+    }
+    file.flush().unwrap();
+    println!(
+        "{{\"sampleRate\":{},\"channels\":{},\"duration\":{},\"landed\":{landed},\"frames\":{frames},\"chunks\":{chunks},\"codec\":\"{}\",\"sourceBits\":{}}}",
+        info.sample_rate,
+        info.channels,
+        info.duration_secs.unwrap_or(-1.0),
+        info.codec,
+        decoder.source_bits().map_or(-1, |b| b as i64)
+    );
+}
