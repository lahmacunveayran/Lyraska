+fn run_limiter(rate: u32, channels: usize, input: &[f64]) -> (Vec<f64>, Vec<f64>, usize) {
+    let mut limiter = Limiter::new(channels, rate);
+    let mut out = input.to_vec();
+    let mut gains = Vec::with_capacity(input.len() / channels);
+    for frame in out.chunks_exact_mut(channels) {
+        limiter.process_frame(frame);
+        gains.push(limiter.gain());
+    }
+    (out, gains, limiter.latency_frames())
+}
