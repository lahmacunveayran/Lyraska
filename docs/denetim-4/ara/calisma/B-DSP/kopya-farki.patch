+    let mut sweep = csv("spec_sweep.csv");
+    write!(sweep, "rate,tone_hz,amp_db").unwrap();
+    for b in 0..BANDS {
+        write!(sweep, ",b{b}").unwrap();
+    }
+    writeln!(sweep).unwrap();
+    for &rate in &[44_100u32, 48_000, 96_000, 22_050] {
+        let r = f64::from(rate);
+        let edges = band_edges(BANDS, r);
+        let centers = band_centers(r);
+        for i in 0..=BANDS {
+            let c = if i < BANDS { centers[i] } else { f64::NAN };
+            writeln!(edges_csv, "{rate},{},{i},{},{c}", fft_size(rate), edges[i]).unwrap();
+        }
+        // Tarama: 160 log aralıklı ton 20 Hz – 0,48·fs, her biri 0,4 s, −20 dBFS; aralarda 0,1 s sessizlik.
+        let seg = (0.4 * r) as usize;
+        let gap = (0.1 * r) as usize;
+        let top = (r * 0.48).min(20_000.0);
+        let tones: Vec<f64> = (0..160)
+            .map(|k| 20.0 * (top / 20.0).powf(k as f64 / 159.0))
+            .collect();
+        let mut signal = Vec::new();
+        for &f in &tones {
+            let mut s = sine(f, r, seg, 0.1, 0.0);
+            // Kenar tıkları analize karışmasın: 5 ms rampa.
+            let ramp = (0.005 * r) as usize;
+            for i in 0..ramp {
+                let g = i as f64 / ramp as f64;
+                s[i] *= g;
+                s[seg - 1 - i] *= g;
+            }
+            signal.extend(s);
+            signal.extend(std::iter::repeat(0.0).take(gap));
+        }
+        let spec = analyze_mono(rate, &signal);
+        for (k, &f) in tones.iter().enumerate() {
+            let t_mid = (k as f64 * (seg + gap) as f64 + seg as f64 / 2.0) / r;
+            let frame = spec.frame_at(t_mid).unwrap();
+            write!(sweep, "{rate},{f},-20").unwrap();
+            for v in frame {
+                write!(sweep, ",{v}").unwrap();
+            }
+            writeln!(sweep).unwrap();
+        }
+        // Seviye ölçeği: 1 kHz tonlar −6, −12, −20, −40, −60, −66 dBFS (0,5 s her biri) ve 100 Hz / 10 kHz −20.
+        let mut signal = Vec::new();
+        let levels_db = [-6.0, -12.0, -20.0, -40.0, -60.0, -66.0];
+        for &db in &levels_db {
+            signal.extend(sine(1000.0, r, (0.5 * r) as usize, 10f64.powf(db / 20.0), 0.0));
+        }
+        signal.extend(sine(100.0, r, (0.5 * r) as usize, 0.1, 0.0));
+        signal.extend(sine(10_000.0, r, (0.5 * r) as usize, 0.1, 0.0));
+        let spec = analyze_mono(rate, &signal);
+        for (k, label) in levels_db
+            .iter()
+            .map(|d| format!("1000@{d}"))
+            .chain(["100@-20".to_owned(), "10000@-20".to_owned()])
+            .enumerate()
+        {
+            let t_mid = (k as f64 + 0.5) * 0.5;
+            let frame = spec.frame_at(t_mid).unwrap();
+            let (f_txt, db_txt) = label.split_once('@').unwrap();
+            write!(sweep, "{rate},{f_txt},{db_txt}").unwrap();
+            for v in frame {
+                write!(sweep, ",{v}").unwrap();
+            }
+            writeln!(sweep).unwrap();
+        }
+    }
+}
