+fn write_f64(name: &str, data: &[f64]) {
+    let mut bytes = Vec::with_capacity(data.len() * 8);
+    for &x in data {
+        bytes.extend_from_slice(&x.to_le_bytes());
+    }
+    fs::write(out_dir().join(name), bytes).unwrap();
+}
+
+fn read_f64(path: &PathBuf) -> Vec<f64> {
+    let bytes = fs::read(path).unwrap();
+    bytes
+        .chunks_exact(8)
+        .map(|c| f64::from_le_bytes(c.try_into().unwrap()))
+        .collect()
+}
+
+fn csv(name: &str) -> fs::File {
+    fs::File::create(out_dir().join(name)).unwrap()
+}
+
+fn sine(freq: f64, rate: f64, n: usize, amp: f64, phase: f64) -> Vec<f64> {
+    (0..n)
+        .map(|i| amp * (2.0 * PI * freq * i as f64 / rate + phase).sin())
+        .collect()
+}
