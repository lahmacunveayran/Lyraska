+fn analyze_mono(rate: u32, mono: &[f64]) -> Arc<Spectrogram> {
+    let st: Vec<f64> = mono.iter().flat_map(|&x| [x, x]).collect();
+    let mut src = Synth::new(rate, 2, st);
+    let s = Spectrogram::new();
+    analyze_source(&mut src, &s, &mut || {});
+    s
+}
