+#[test]
+fn spektrum_zamanlama_ve_vu() {
+    let mut timing = csv("spec_timing.csv");
+    writeln!(timing, "rate,t,band_level,rms_l_db,rms_r_db,peak_l_db,peak_r_db").unwrap();
+    let mut vu = csv("spec_vu.csv");
+    writeln!(vu, "rate,vu_reference_db,python_check").unwrap();
+    for &rate in &[44_100u32, 48_000, 96_000, 22_050] {
+        let r = f64::from(rate);
+        // 2,000 s sessizlik, 50 ms 1 kHz −6 dBFS patlama, sonra 1 s sessizlik; sonra VU için
+        // 0,3 s basamaklar: −30, −20, −12, −6, −3 dBFS 1 kHz (sol), sağ 6 dB daha kısık.
+        let n_total = (6.0 * r) as usize;
+        let mut st = vec![0.0; 2 * n_total];
+        let burst_start = (2.0 * r) as usize;
+        let burst_len = (0.05 * r) as usize;
+        for i in 0..burst_len {
+            let x = 0.5 * (2.0 * PI * 1000.0 * i as f64 / r).sin();
+            st[2 * (burst_start + i)] = x;
+            st[2 * (burst_start + i) + 1] = x;
+        }
+        let steps = [-30.0, -20.0, -12.0, -6.0, -3.0, -40.0, -8.0, -60.0];
+        let step_len = (0.3 * r) as usize;
+        let steps_start = (3.0 * r) as usize;
+        for (k, &db) in steps.iter().enumerate() {
+            let a = 10f64.powf(db / 20.0);
+            for i in 0..step_len {
+                let idx = steps_start + k * step_len + i;
+                let x = a * (2.0 * PI * 1000.0 * i as f64 / r).sin();
+                st[2 * idx] = x;
+                st[2 * idx + 1] = x * 0.5;
+            }
+        }
+        write_f64(&format!("spec_timing_{rate}_in.f64"), &st);
+        let mut src = Synth::new(rate, 2, st.clone());
+        let spec = Spectrogram::new();
+        analyze_source(&mut src, &spec, &mut || {});
+        // 1 kHz bandı: band_edges ile bul.
+        let edges = band_edges(BANDS, r);
+        let band_1k = (0..BANDS)
+            .find(|&i| edges[i] <= 1000.0 && 1000.0 < edges[i + 1])
+            .unwrap();
+        let mut t = 0.0;
+        while t < 6.0 {
+            let lvl = spec.frame_at(t).map_or(-1.0, |f| f64::from(f[band_1k]));
+            let m = spec.meters_at(t);
+            let (rl, rr, pl, pr) = m.map_or((f64::NAN, f64::NAN, f64::NAN, f64::NAN), |m| {
+                (
+                    f64::from(m.rms_db[0]),
+                    f64::from(m.rms_db[1]),
+                    f64::from(m.peak_db[0]),
+                    f64::from(m.peak_db[1]),
+                )
+            });
+            writeln!(timing, "{rate},{t:.4},{lvl},{rl},{rr},{pl},{pr}").unwrap();
+            t += 0.001;
+        }
+        writeln!(
+            vu,
+            "{rate},{},",
+            spec.vu_reference_db().map_or(f64::NAN, f64::from)
+        )
+        .unwrap();
+    }
+    // VU referansı: doğrudan levels::vu_reference_db ile, python'da yeniden hesaplanabilir
+    // bir kare dizisi (dekode edilmiş rms değerleri de yazılır).
+    let rate = 48_000u32;
+    let r = f64::from(rate);
+    let frames_per_sec = 60.0;
+    let mut acc = LevelAccumulator::default();
+    let mut stored = Vec::new();
+    let mut rms_csv = csv("vu_frames.csv");
+    writeln!(rms_csv, "frame,rms_l_db,rms_r_db,peak_l_db,peak_r_db").unwrap();
+    // 20 s: rastgele genlikli 1 kHz, her 100 ms'de bir genlik değişir (log-düzgün −40..0 dB),
+    // ilk 2 s sessiz.
+    let mut s: u64 = 5;
+    let n = 20 * rate as usize;
+    let mut amp = 0.0;
+    let mut next_change = 0;
+    let mut next_frame_end = ((r * 1.0 * 2.0 + frames_per_sec) / (2.0 * frames_per_sec)) as usize;
+    let mut frame_index = 0u64;
+    let mut sig = Vec::with_capacity(n);
+    for i in 0..n {
+        if i == next_change {
+            s = s.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+            let u = (s >> 11) as f64 / (1u64 << 53) as f64;
+            amp = if i < 2 * rate as usize {
+                0.0
+            } else {
+                10f64.powf((-40.0 + 40.0 * u) / 20.0)
+            };
+            next_change += rate as usize / 10;
+        }
+        let x = amp * (2.0 * PI * 1000.0 * i as f64 / r).sin();
+        sig.push(x);
+        acc.add(&[x, 0.5 * x]);
+        if i + 1 == next_frame_end {
+            let f = acc.finish();
+            let d = levels::decode_frame(&f).unwrap();
+            writeln!(
+                rms_csv,
+                "{frame_index},{},{},{},{}",
+                d.rms_db[0], d.rms_db[1], d.peak_db[0], d.peak_db[1]
+            )
+            .unwrap();
+            stored.extend_from_slice(&f);
+            frame_index += 1;
+            next_frame_end = (((frame_index + 1) as f64 * r * 2.0 + frames_per_sec)
+                / (2.0 * frames_per_sec)) as usize;
+        }
+    }
+    write_f64("vu_signal.f64", &sig);
+    let reference = levels::vu_reference_db(&stored, frames_per_sec);
+    writeln!(vu, "48000_direct,{},", reference.map_or(f64::NAN, f64::from)).unwrap();
+}
