+#[test]
+fn yeniden_ornekleme() {
+    let pairs = [
+        (44_100u32, 48_000u32),
+        (48_000, 44_100),
+        (96_000, 48_000),
+        (44_100, 96_000),
+        (22_050, 48_000),
+        (192_000, 48_000),
+    ];
+    let mut manifest = csv("rs_manifest.csv");
+    writeln!(manifest, "kind,from,to,freq,in_len,out_len,file").unwrap();
+    for &(from, to) in &pairs {
+        // Dürtü yanıtı (gecikme, hizalama ve frekans yanıtı): 2 s, darbe 1. saniyede.
+        let n = 2 * from as usize;
+        let mut imp = vec![0.0; n];
+        imp[from as usize] = 1.0;
+        let mut c = Converter::new(from, 1, to, 1).unwrap();
+        let out = convert_all(&mut c, &imp, 1000);
+        let file = format!("rs_{from}_{to}_impulse.f64");
+        write_f64(&file, &out);
+        writeln!(manifest, "impulse,{from},{to},0,{n},{},{file}", out.len()).unwrap();
+        // Dürtü, farklı parça boyutuyla (parça sınırı bağımsızlığı).
+        let mut c = Converter::new(from, 1, to, 1).unwrap();
+        let out2 = convert_all(&mut c, &imp, 777);
+        let file = format!("rs_{from}_{to}_impulse777.f64");
+        write_f64(&file, &out2);
+        writeln!(manifest, "impulse777,{from},{to},0,{n},{},{file}", out2.len()).unwrap();
+        // Basamaklı sinüsler: 20 Hz – 0,499·fs_in, her biri 1 s, genlik 0,5.
+        let top = f64::from(from) * 0.499;
+        for k in 0..48 {
+            let f = 20.0 * (top / 20.0).powf(k as f64 / 47.0);
+            let n = from as usize;
+            let input = sine(f, f64::from(from), n, 0.5, 0.0);
+            let mut c = Converter::new(from, 1, to, 1).unwrap();
+            let out = convert_all(&mut c, &input, 1000);
+            let file = format!("rs_{from}_{to}_tone{k}.f64");
+            write_f64(&file, &out);
+            writeln!(manifest, "tone,{from},{to},{f},{n},{},{file}", out.len()).unwrap();
+        }
+        // Uzunluk: tuhaf sayıda kare (1 000 001) ve çok kısa (10 kare) giriş.
+        for &len in &[1_000_001usize, 10, 2048, 2049] {
+            let input = sine(440.0, f64::from(from), len, 0.5, 0.0);
+            let mut c = Converter::new(from, 2, to, 2).unwrap();
+            let st: Vec<f64> = input.iter().flat_map(|&x| [x, -x]).collect();
+            let out = convert_all(&mut c, &st, 4096);
+            writeln!(manifest, "length,{from},{to},440,{len},{},-", out.len() / 2).unwrap();
+        }
+    }
+}
