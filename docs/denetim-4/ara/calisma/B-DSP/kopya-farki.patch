+#[test]
+fn sinirlayici() {
+    let mut manifest = csv("lim_manifest.csv");
+    writeln!(manifest, "name,rate,channels,latency").unwrap();
+    for &rate in &[44_100u32, 48_000, 96_000] {
+        let r = f64::from(rate);
+        let n = 3 * rate as usize;
+        let mut cases: Vec<(String, Vec<f64>)> = Vec::new();
+        // fs/4, 45°, genlik 1,4 (gerçek tepe +2,9 dBTP; örnekler ±0,99).
+        cases.push((
+            "fs4_45deg_1.4".into(),
+            (0..n).map(|i| 1.4 * (PI / 2.0 * i as f64 + PI / 4.0).sin()).collect(),
+        ));
+        // Sert kırpılmış 0,2·fs (44,1'de 8,8 kHz).
+        cases.push((
+            "clip_0.2fs".into(),
+            (0..n)
+                .map(|i| (1.6 * (2.0 * PI * 0.2 * i as f64).sin()).clamp(-1.0, 1.0))
+                .collect(),
+        ));
+        // Nyquist'e yakın: 0,45·fs, genlik 1,2.
+        cases.push((
+            "sine_0.45fs_1.2".into(),
+            (0..n).map(|i| 1.2 * (2.0 * PI * 0.45 * i as f64 + 0.3).sin()).collect(),
+        ));
+        // 0,48·fs genlik 1,0 (kısa ara değerleyicinin en zorlandığı yer).
+        cases.push((
+            "sine_0.48fs_1.0".into(),
+            (0..n).map(|i| 1.0 * (2.0 * PI * 0.48 * i as f64 + 0.1).sin()).collect(),
+        ));
+        // 1 kHz 0 dBFS (sınırı 1 dB aşar): kararlı durumda bozulma.
+        cases.push(("sine_1k_0dBFS".into(), sine(1000.0, r, n, 1.0, 0.0)));
+        // Tam ölçekli kırpılmış Gauss gürültü.
+        let mut s: u64 = 42;
+        let mut noise = Vec::with_capacity(n);
+        for _ in 0..n {
+            // Box-Muller
+            s = s.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+            let u1 = ((s >> 11) as f64 / (1u64 << 53) as f64).max(1e-300);
+            s = s.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+            let u2 = (s >> 11) as f64 / (1u64 << 53) as f64;
+            let g = (-2.0 * u1.ln()).sqrt() * (2.0 * PI * u2).cos();
+            noise.push((0.7 * g).clamp(-1.0, 1.0));
+        }
+        cases.push(("clipnoise".into(), noise));
+        // Kare dalga 0,1·fs genlik 1,0 (ani geçişler) ve darbeler.
+        cases.push((
+            "square_0.1fs".into(),
+            (0..n)
+                .map(|i| if (i / 5) % 2 == 0 { 1.0 } else { -1.0 })
+                .collect(),
+        ));
+        cases.push((
+            "spikes_in_sine".into(),
+            (0..n)
+                .map(|i| {
+                    let x = 0.85 * (2.0 * PI * 220.0 * i as f64 / r).sin();
+                    if i % 7000 == 100 {
+                        1.9
+                    } else {
+                        x
+                    }
+                })
+                .collect(),
+        ));
+        // Pompalama: 100 Hz −6 dB taşıyıcı + her 500 ms'de 10 ms'lik 1,3 genlikli 2 kHz patlama.
+        cases.push((
+            "pumping".into(),
+            (0..n)
+                .map(|i| {
+                    let t = i as f64 / r;
+                    let carrier = 0.5 * (2.0 * PI * 100.0 * t).sin();
+                    let burst_phase = t % 0.5;
+                    if burst_phase < 0.01 {
+                        carrier + 1.3 * (2.0 * PI * 2000.0 * t).sin()
+                    } else {
+                        carrier
+                    }
+                })
+                .collect(),
+        ));
+        // Gecikme: tek darbe.
+        let mut impulse = vec![0.0; n];
+        impulse[rate as usize] = 0.5;
+        cases.push(("impulse".into(), impulse));
+        // "Modern master" taklidi: −0,3 dBFS'e kırpılmış 3 kHz'e kadar gürültü + 60 Hz bas.
+        let mut master = Vec::with_capacity(n);
+        let mut lp = 0.0;
+        let mut s2: u64 = 99;
+        for i in 0..n {
+            s2 = s2.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+            let u = (s2 >> 11) as f64 / (1u64 << 53) as f64 * 2.0 - 1.0;
+            lp += 0.15 * (u - lp);
+            let x = 0.6 * (2.0 * PI * 60.0 * i as f64 / r).sin() + 2.5 * lp;
+            master.push(x.clamp(-0.966, 0.966));
+        }
+        cases.push(("master_-0.3dBFS".into(), master));
+        // Aynısı −1,5 dBFS: sınırlayıcı hiç dokunmamalı.
+        let quiet: Vec<f64> = cases.last().unwrap().1.iter().map(|x| x * 0.87).collect();
+        cases.push(("master_-1.5dBFS".into(), quiet));
+
+        for (name, input) in cases {
+            let (out, gains, latency) = run_limiter(rate, 1, &input);
+            write_f64(&format!("lim_{rate}_{name}_in.f64"), &input);
+            write_f64(&format!("lim_{rate}_{name}_out.f64"), &out);
+            write_f64(&format!("lim_{rate}_{name}_gain.f64"), &gains);
+            writeln!(manifest, "{name},{rate},1,{latency}").unwrap();
+        }
+    }
+    // Stereo: tek kanalda taşma öteki kanalı da kısıyor mu (bağlı kazanç)?
+    let rate = 48_000u32;
+    let n = 2 * rate as usize;
+    let mut st = Vec::with_capacity(2 * n);
+    for i in 0..n {
+        st.push(1.4 * (PI / 2.0 * i as f64 + PI / 4.0).sin());
+        st.push(0.3 * (2.0 * PI * 440.0 * i as f64 / 48_000.0).sin());
+    }
+    let (out, gains, latency) = run_limiter(rate, 2, &st);
+    write_f64("lim_48000_stereo_in.f64", &st);
+    write_f64("lim_48000_stereo_out.f64", &out);
+    write_f64("lim_48000_stereo_gain.f64", &gains);
+    writeln!(manifest, "stereo,48000,2,{latency}").unwrap();
+}
