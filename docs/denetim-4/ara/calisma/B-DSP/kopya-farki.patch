+struct Synth {
+    info: TrackInfo,
+    data: Vec<f64>,
+    pos: usize,
+    buf: Vec<f64>,
+}
+
+impl Synth {
+    fn new(rate: u32, channels: usize, data: Vec<f64>) -> Self {
+        Self {
+            info: TrackInfo {
+                path: PathBuf::from("sentetik"),
+                file_name: "sentetik".into(),
+                title: None,
+                artist: None,
+                album: None,
+                album_artist: None,
+                track_number: None,
+                disc_number: None,
+                codec: "pcm".into(),
+                sample_rate: rate,
+                channels,
+                duration_secs: None,
+            },
+            data,
+            pos: 0,
+            buf: Vec::new(),
+        }
+    }
+}
+
+impl ChunkSource for Synth {
+    fn info(&self) -> &TrackInfo {
+        &self.info
+    }
+    fn next_chunk(&mut self) -> Result<Option<&[Sample]>, AudioError> {
+        if self.pos >= self.data.len() {
+            return Ok(None);
+        }
+        let end = (self.pos + 4096 * self.info.channels).min(self.data.len());
+        self.buf.clear();
+        self.buf.extend_from_slice(&self.data[self.pos..end]);
+        self.pos = end;
+        Ok(Some(&self.buf))
+    }
+}
