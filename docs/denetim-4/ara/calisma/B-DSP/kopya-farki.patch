+// ------------------------------------------------------------------------------------------
+// 6. Uçtan uca ses yolu
+// ------------------------------------------------------------------------------------------
+
+fn render_all(renderer: &mut Renderer, input: &[f64], channels: usize, block: usize,
+              paused_at: &dyn Fn(usize) -> bool) -> Vec<f64> {
+    let (mut producer, mut consumer) = RingBuffer::new(input.len().max(1));
+    for &s in input {
+        producer.push(s).unwrap();
+    }
+    let total_frames = input.len() / channels;
+    let mut out = Vec::new();
+    let mut buf = vec![0.0; block * channels];
+    let mut frame = 0usize;
+    // Girişten daha uzun çalıştır (gecikme hattı boşalsın); duraklatma deseni bloğa göre.
+    let extra = 4000;
+    while frame < total_frames + extra {
+        renderer.render(&mut consumer, &mut buf, paused_at(frame));
+        out.extend_from_slice(&buf);
+        frame += block;
+    }
+    out
+}
