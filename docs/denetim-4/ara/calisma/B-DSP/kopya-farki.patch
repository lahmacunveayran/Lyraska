+fn convert_all(c: &mut Converter, input: &[f64], chunk: usize) -> Vec<f64> {
+    let mut out = Vec::new();
+    for piece in input.chunks(chunk) {
+        out.extend_from_slice(c.process(piece).unwrap());
+    }
+    out.extend_from_slice(c.finish().unwrap());
+    out
+}
