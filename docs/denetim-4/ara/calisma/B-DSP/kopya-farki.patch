+/// Ayar değişirken tık/zipper: 100 Hz sinüs çalarken uzak bantlar (2 kHz −12, 8 kHz +12) ve
+/// aç/kapa anahtarı değişir. Ayrıca 1 kHz bandı 0 → +12 → 0.
+#[test]
+fn eq_zipper() {
+    let rate = 48_000u32;
+    let n = 4 * rate as usize;
+    let control = Arc::new(EqControl::new(EqSettings::default()));
+    let mut p = EqProcessor::new(Arc::clone(&control), 1, rate);
+    let input = sine(100.0, f64::from(rate), n, 0.5, 0.0);
+    let mut out = Vec::with_capacity(n);
+    let far = {
+        let mut g = [0.0; EQ_BANDS];
+        g[6] = -12.0;
+        g[8] = 12.0;
+        g
+    };
+    let block = 480;
+    for b in 0..n / block {
+        let t = b * block;
+        if t == rate as usize / 2 {
+            control.set(EqSettings {
+                enabled: true,
+                gains_db: far,
+                ..EqSettings::default()
+            });
+        }
+        if t == rate as usize * 3 / 2 {
+            control.set(EqSettings {
+                enabled: false,
+                gains_db: far,
+                ..EqSettings::default()
+            });
+        }
+        if t == rate as usize * 2 {
+            control.set(EqSettings {
+                enabled: true,
+                gains_db: far,
+                ..EqSettings::default()
+            });
+        }
+        if t == rate as usize * 5 / 2 {
+            control.set(EqSettings {
+                enabled: true,
+                gains_db: [0.0; EQ_BANDS],
+                ..EqSettings::default()
+            });
+        }
+        p.begin_block();
+        for i in t..t + block {
+            p.advance_frame();
+            out.push(p.process(0, input[i]));
+        }
+    }
+    write_f64("eq_zipper_in.f64", &input);
+    write_f64("eq_zipper_out.f64", &out);
+
+    // Kendi bandı değişirken: 1 kHz sinüs, 1 kHz bandı 0 → +12 (0,5 s) → −12 (1,5 s) → 0 (2,5 s).
+    let control = Arc::new(EqControl::new(EqSettings::default()));
+    let mut p = EqProcessor::new(Arc::clone(&control), 1, rate);
+    let input = sine(1000.0, f64::from(rate), n, 0.2, 0.0);
+    let mut out = Vec::with_capacity(n);
+    for b in 0..n / block {
+        let t = b * block;
+        let mut g = [0.0; EQ_BANDS];
+        if t == rate as usize / 2 {
+            g[5] = 12.0;
+            control.set(EqSettings {
+                enabled: true,
+                gains_db: g,
+                ..EqSettings::default()
+            });
+        }
+        if t == rate as usize * 3 / 2 {
+            g[5] = -12.0;
+            control.set(EqSettings {
+                enabled: true,
+                gains_db: g,
+                ..EqSettings::default()
+            });
+        }
+        if t == rate as usize * 5 / 2 {
+            control.set(EqSettings::default());
+        }
+        p.begin_block();
+        for i in t..t + block {
+            p.advance_frame();
+            out.push(p.process(0, input[i]));
+        }
+    }
+    write_f64("eq_zipper2_in.f64", &input);
+    write_f64("eq_zipper2_out.f64", &out);
+}
