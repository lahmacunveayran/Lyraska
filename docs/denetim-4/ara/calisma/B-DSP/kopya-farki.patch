+        let mut renderer = Renderer::new(channels, rate, RenderControls::default());
+        let latency = renderer.latency_frames();
+        let block = 48;
+        let pause = move |frame: usize| {
+            let t = frame as f64 / r;
+            (1.0..1.5).contains(&t) || (2.0..2.004).contains(&t)
+        };
+        let out = render_all(&mut renderer, &input, channels, block, &pause);
+        write_f64(&format!("e2e_{rate}_pause_in.f64"), &input);
+        write_f64(&format!("e2e_{rate}_pause_out.f64"), &out);
+        writeln!(manifest, "pause,{rate},{channels},{latency},{block}").unwrap();
+    }
