+/// 16 bitlik "müzik" taklidi: 60 Hz + 440 Hz + 3 kHz + süzülmüş gürültü, tepe `peak`'e ölçekli,
+/// 16 bite yuvarlanmış.
+fn music16(rate: u32, seconds: f64, peak: f64) -> Vec<f64> {
+    let r = f64::from(rate);
+    let n = (seconds * r) as usize;
+    let mut s: u64 = 1234;
+    let mut lp = 0.0;
+    let mut raw = Vec::with_capacity(n);
+    for i in 0..n {
+        s = s.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+        let u = (s >> 11) as f64 / (1u64 << 53) as f64 * 2.0 - 1.0;
+        lp += 0.2 * (u - lp);
+        let t = i as f64 / r;
+        let env = 0.6 + 0.4 * (2.0 * PI * 0.5 * t).sin();
+        raw.push(
+            env * (0.5 * (2.0 * PI * 60.0 * t).sin()
+                + 0.3 * (2.0 * PI * 440.0 * t).sin()
+                + 0.15 * (2.0 * PI * 3000.0 * t).sin()
+                + 0.8 * lp),
+        );
+    }
+    let max = raw.iter().fold(0.0f64, |m, x| m.max(x.abs()));
+    raw.iter()
+        .map(|x| ((x / max * peak) * 32768.0).round().clamp(-32768.0, 32767.0) / 32768.0)
+        .collect()
+}
