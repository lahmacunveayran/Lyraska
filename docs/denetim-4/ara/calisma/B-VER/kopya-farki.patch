+#[test]
+fn bver_yeniden_adlandirilan_dosyanin_analizi_silinir_ve_bastan_hesaplanir() {
+    let dir = dir_with(&[("gece-a.mp3", "Gece A.mp3"), ("isik.flac", "Işık.flac")]);
+    let db = temp_path("library.sqlite3");
+    let library = Mutex::new(Library::open(&db).unwrap());
+    let folder = library.lock().unwrap().add_folder(&dir.to_string_lossy()).unwrap();
+    let state = ScanState::default();
+    scan_folder(&library, &folder, &state).unwrap();
+    let cache = AnalysisCache::open(&db).unwrap();
+    let saved = analyze_file(&ses("isik.flac"));
+    for name in ["Gece A.mp3", "Işık.flac"] {
+        let p = dir.join(name);
+        cache.store(&p, FileStamp::of(&p).unwrap(), &saved).unwrap();
+    }
+    assert_eq!(cache.pending_library_tracks(10).unwrap().len(), 0, "ikisi de analizli");
+
+    // Kullanıcı dosyayı yeniden adlandırdı (içerik aynı).
+    std::fs::rename(dir.join("Gece A.mp3"), dir.join("01 - Gece A.mp3")).unwrap();
+    let summary = scan_folder(&library, &folder, &state).unwrap();
+    let analyses = count(&cache.lock_for_test(), "SELECT COUNT(*) FROM analyses");
+    let pending = cache.pending_library_tracks(10).unwrap();
+    println!(
+        "YENİDEN ADLANDIRMA: removed={} updated={} | analiz kaydı {analyses} (2 idi) | yeniden analiz \
+         bekleyen: {:?}",
+        summary.removed,
+        summary.updated,
+        pending.iter().map(|(p, _)| p.file_name().unwrap().to_string_lossy().into_owned()).collect::<Vec<_>>()
+    );
+    assert_eq!(summary.removed, 1);
+    assert_eq!(analyses, 1, "eski yolun analizi tetikleyiciyle silindi");
+    assert_eq!(pending.len(), 1, "aynı içerik baştan analiz edilecek");
+}
