+         dosya {:.0} KB",
+        saved.frames(),
+        total as f64 / 1024.0,
+        (saved.levels.len() + saved.meters.len() + saved.onset.len() * 4) as f64 / 1024.0,
+        std::fs::metadata(&db).unwrap().len() as f64 / 1024.0
+    );
+}
