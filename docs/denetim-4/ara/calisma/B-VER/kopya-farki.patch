+             coalesce(length(beats),0), coalesce(length(song_map),0) FROM analyses",
+            [],
+            |r| Ok((r.get(0)?, r.get(1)?, r.get(2)?, r.get(3)?, r.get(4)?, r.get(5)?)),
+        )
+        .unwrap();
+    conn.execute_batch("PRAGMA wal_checkpoint(TRUNCATE)").unwrap();
+    drop(conn);
+    let total = levels + meters + onset + chroma + beats + map;
+    println!(
