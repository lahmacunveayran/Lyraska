+// ---------------------------------------------------------------- 6. Eşzamanlılık
+
+#[test]
+fn bver_eszamanlilik_stresi() {
+    let db = temp_path("library.sqlite3");
+    let library = Arc::new(Mutex::new(Library::open(&db).unwrap()));
+    let folder = library.lock().unwrap().add_folder("/muzik").unwrap();
+    let cache = Arc::new(AnalysisCache::open(&db).unwrap());
+    let saved = Arc::new(analyze_file(&ses("isik.flac")));
+    let stamp = FileStamp { size: 1, modified: 1 };
+    let deadline = Instant::now() + Duration::from_secs(8);
+    let errors = Arc::new(Mutex::new(Vec::<String>::new()));
+    let mut handles = Vec::new();
+
+    // Tarama yazıcısı: 200'lük toplu yazmalar + silmeler (scan.rs'in yaptığı gibi).
+    {
+        let (library, errors) = (Arc::clone(&library), Arc::clone(&errors));
+        handles.push(std::thread::spawn(move || {
+            let (mut batches, mut max_ms) = (0usize, 0u128);
+            let mut n = 0usize;
+            while Instant::now() < deadline {
+                let upserts: Vec<_> = (0..200)
+                    .map(|i| {
+                        let mut info = track_info(&format!("/muzik/{}.flac", n + i));
+                        info.title = Some(format!("Gece {}", n + i));
+                        (info, stamp)
+                    })
+                    .collect();
+                let removed: Vec<String> = (0..20).map(|i| format!("/muzik/{}.flac", n / 2 + i)).collect();
+                n += 200;
+                let t = Instant::now();
+                let r = library.lock().unwrap().apply_changes(folder.id, &upserts, &removed);
+                max_ms = max_ms.max(t.elapsed().as_millis());
+                if let Err(e) = r {
+                    errors.lock().unwrap().push(format!("tarama: {e}"));
+                }
+                batches += 1;
+            }
+            ("tarama yazıcısı", batches, max_ms)
+        }));
+    }
+    // Analiz yazıcısı (çalan + arka plan): sürekli cache.store.
+    for name in ["analiz yazıcısı A", "analiz yazıcısı B"] {
+        let (cache, errors, saved) = (Arc::clone(&cache), Arc::clone(&errors), Arc::clone(&saved));
+        handles.push(std::thread::spawn(move || {
+            let (mut stores, mut max_ms) = (0usize, 0u128);
+            while Instant::now() < deadline {
+                let t = Instant::now();
+                let r = cache.store(Path::new(&format!("/muzik/{}.flac", stores % 3000)), stamp, &saved);
+                max_ms = max_ms.max(t.elapsed().as_millis());
+                if let Err(e) = r {
+                    errors.lock().unwrap().push(format!("{name}: {e}"));
+                }
+                stores += 1;
+            }
+            (name, stores, max_ms)
+        }));
+    }
+    // Arayüz: arama + durum (status) döngüsü.
+    {
+        let (library, errors) = (Arc::clone(&library), Arc::clone(&errors));
+        handles.push(std::thread::spawn(move || {
+            let (mut reads, mut max_ms) = (0usize, 0u128);
+            while Instant::now() < deadline {
+                let t = Instant::now();
+                let lib = library.lock().unwrap();
+                let r = lib
+                    .search("gece", 50_000)
+                    .and_then(|_| lib.analyzed_count())
+                    .and_then(|_| lib.track_count());
+                drop(lib);
+                max_ms = max_ms.max(t.elapsed().as_millis());
+                if let Err(e) = r {
+                    errors.lock().unwrap().push(format!("arayüz: {e}"));
+                }
+                reads += 1;
+                std::thread::sleep(Duration::from_millis(5));
+            }
+            ("arayüz okuyucu (kilit dahil)", reads, max_ms)
+        }));
+    }
+    // Arka plan analizi: bekleyenleri sorar.
+    {
+        let (cache, errors) = (Arc::clone(&cache), Arc::clone(&errors));
+        handles.push(std::thread::spawn(move || {
+            let (mut reads, mut max_ms) = (0usize, 0u128);
+            while Instant::now() < deadline {
+                let t = Instant::now();
+                if let Err(e) = cache.pending_library_tracks(16) {
+                    errors.lock().unwrap().push(format!("arka plan: {e}"));
+                }
+                max_ms = max_ms.max(t.elapsed().as_millis());
+                reads += 1;
+            }
+            ("arka plan bekleyen sorgusu", reads, max_ms)
+        }));
+    }
+    for h in handles {
+        let (name, n, max_ms) = h.join().unwrap();
+        println!("EŞZAMANLILIK: {name:30} {n:6} işlem, en uzun {max_ms} ms");
+    }
+    let errors = errors.lock().unwrap();
+    println!("EŞZAMANLILIK: hata sayısı {} {:?}", errors.len(), errors.iter().take(3).collect::<Vec<_>>());
+    let lib = library.lock().unwrap();
+    let tracks = lib.track_count().unwrap();
+    let analyses = count(&cache.lock_for_test(), "SELECT COUNT(*) FROM analyses");
+    let integrity: String = cache
+        .lock_for_test()
+        .query_row("PRAGMA integrity_check", [], |r| r.get(0))
+        .unwrap();
+    println!("EŞZAMANLILIK: sonunda tracks={tracks} analyses={analyses} integrity={integrity}");
+    assert!(errors.is_empty());
+}
