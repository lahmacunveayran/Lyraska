+    cache.store(&path, FileStamp::of(&path).unwrap(), &saved).unwrap();
+    let conn = cache.lock_for_test();
+    let (levels, meters, onset, chroma, beats, map): (i64, i64, i64, i64, i64, i64) = conn
+        .query_row(
