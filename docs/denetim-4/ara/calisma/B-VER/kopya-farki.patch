+#[test]
+fn bver_okunamayan_alt_klasor_ve_kok() {
+    // Yalnızca ayrıcalıksız kullanıcıyla anlamlı (root her şeyi okur): setpriv ile çalıştırılır.
+    let dir = dir_with(&[("gece-a.mp3", "a.mp3"), ("isik.flac", "gizli/b.flac")]);
+    let db = temp_path("library.sqlite3");
+    let library = Mutex::new(Library::open(&db).unwrap());
+    let folder = library.lock().unwrap().add_folder(&dir.to_string_lossy()).unwrap();
+    let state = ScanState::default();
+    scan_folder(&library, &folder, &state).unwrap();
+    assert_eq!(library.lock().unwrap().track_count().unwrap(), 2);
+    use std::os::unix::fs::PermissionsExt;
+    std::fs::set_permissions(dir.join("gizli"), std::fs::Permissions::from_mode(0o000)).unwrap();
+    let readable = std::fs::read_dir(dir.join("gizli")).is_ok();
+    let summary = scan_folder(&library, &folder, &state).unwrap();
+    let left = library.lock().unwrap().track_count().unwrap();
+    println!(
+        "OKUNAMAYAN ALT KLASÖR (root olarak mı: {readable}): unreadable={} removed={} → kalan {left}",
+        summary.unreadable, summary.removed
+    );
+    std::fs::set_permissions(dir.join("gizli"), std::fs::Permissions::from_mode(0o755)).unwrap();
+    if !readable {
+        assert_eq!(summary.unreadable, 1);
+        assert_eq!(left, 2, "okunamayan klasörün şarkısı silinmez");
+    }
+}
