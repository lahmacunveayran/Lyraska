+    let t = Instant::now();
+    let lib = Library::open(&db).unwrap();
+    let open_ms = t.elapsed().as_millis();
+    let t = Instant::now();
+    let all = lib.search("", 50_000).unwrap();
+    let search_ms = t.elapsed().as_millis();
+    let t = Instant::now();
+    let json = serde_json::to_string(&all).unwrap();
+    let json_ms = t.elapsed().as_millis();
+    let t = Instant::now();
+    let found = lib.search("gece yarisi", 50_000).unwrap().len();
+    let word_ms = t.elapsed().as_millis();
+    let t = Instant::now();
+    let analyzed = lib.analyzed_count().unwrap();
+    let analyzed_ms = t.elapsed().as_millis();
+    println!(
+        "ÖLÇEK 50k: açılış {open_ms} ms | search('') {} satır {search_ms} ms + JSON {:.1} MB {json_ms} ms | \
+         search('gece yarisi') {found} satır {word_ms} ms | analyzed_count={analyzed} {analyzed_ms} ms",
+        all.len(),
+        json.len() as f64 / 1e6
