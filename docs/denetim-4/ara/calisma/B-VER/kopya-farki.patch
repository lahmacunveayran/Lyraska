+#[test]
+fn bver_ayni_boyut_ayni_zaman_farkli_etiket_fark_edilmez() {
+    let dir = dir_with(&[("gece-a.mp3", "gece.mp3")]);
+    let db = temp_path("library.sqlite3");
+    let library = Mutex::new(Library::open(&db).unwrap());
+    let folder = library.lock().unwrap().add_folder(&dir.to_string_lossy()).unwrap();
+    let state = ScanState::default();
+    scan_folder(&library, &folder, &state).unwrap();
+    assert_eq!(library.lock().unwrap().search("", 10).unwrap()[0].title, "Gece A");
+
+    // Etiket düzenleyici (Mp3tag "değişiklik zamanını koru" seçeneği) başlığı aynı uzunlukta
+    // değiştirdi: boyut ve değişme zamanı aynı kaldı.
+    let target = dir.join("gece.mp3");
+    let modified = std::fs::metadata(&target).unwrap().modified().unwrap();
+    std::fs::copy(ses("gece-b.mp3"), &target).unwrap();
+    std::fs::File::options().write(true).open(&target).unwrap().set_modified(modified).unwrap();
+    let summary = scan_folder(&library, &folder, &state).unwrap();
+    let title = library.lock().unwrap().search("", 10).unwrap()[0].title.clone();
+    println!(
+        "AYNI DAMGA: diskteki başlık 'Gece B', tarama unchanged={} updated={}, kütüphanedeki başlık '{title}'",
+        summary.unchanged, summary.updated
+    );
+    assert_eq!(summary.unchanged, 1);
+    assert_eq!(title, "Gece A", "değişiklik görülmez (tasarım: boyut + zaman damgası)");
+}
