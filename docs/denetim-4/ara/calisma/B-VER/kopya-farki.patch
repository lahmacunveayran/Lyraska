+#[test]
+fn bver_goc_her_eski_surum_verisini_korur() {
+    for name in ["v1", "v2", "v3", "v4", "v5", "v6", "v7", "yarim"] {
+        let src = Path::new(CALISMA).join("goc").join(format!("{name}.sqlite3"));
+        let db = temp_path("library.sqlite3");
+        std::fs::copy(&src, &db).unwrap();
+        for suffix in ["-wal", "-shm"] {
+            let side = PathBuf::from(format!("{}{suffix}", src.display()));
+            if side.exists() {
+                std::fs::copy(&side, format!("{}{suffix}", db.display())).unwrap();
+            }
+        }
+        // Programın açılışı: önce kütüphane, sonra önbellek (lib.rs sırası).
+        let library = Library::open(&db).unwrap_or_else(|e| panic!("{name}: {e}"));
+        let cache = AnalysisCache::open(&db).unwrap_or_else(|e| panic!("{name}: {e}"));
+        let tracks = library.search("", 100).unwrap();
+        let titles: Vec<_> = tracks.iter().map(|t| t.title.as_str()).collect();
+        let conn = cache.lock_for_test();
+        let version = count(&conn, "PRAGMA user_version");
+        let analyses = count(&conn, "SELECT COUNT(*) FROM analyses");
+        let frames_ok = count(
+            &conn,
+            "SELECT COUNT(*) FROM analyses WHERE frames IN (600,601,602) AND bpm IN (120,121,122) \
+             AND length(levels) = 100 AND beats = '{\"bpm\":120}'",
+        );
+        let valid_spectrum = count(&conn, "SELECT COUNT(*) FROM analyses WHERE spectrum_version >= 1");
+        let stale_tags: Vec<String> = {
+            let mut s = conn
+                .prepare("SELECT file_name FROM tracks WHERE tags_version = 0 ORDER BY path")
+                .unwrap();
+            s.query_map([], |r| r.get(0)).unwrap().map(Result::unwrap).collect()
+        };
+        let recovery = library.recovery_notice().map(str::to_owned);
+        drop(conn);
+        let pending = cache.pending_library_tracks(100).unwrap().len();
+        let bpm_shown = tracks.iter().filter(|t| t.bpm.is_some()).count();
+        println!(
+            "GÖÇ {name:5} → şema {version}: klasör {} şarkı {} analiz {} (içerik sağlam {frames_ok}, \
+             kareleri geçerli {valid_spectrum}) | listede BPM gösterilen {bpm_shown}, analiz bekleyen \
+             {pending}, etiketi yeniden okunacak {stale_tags:?} | kurtarma: {recovery:?}",
+            library.folders().unwrap().len(),
+            tracks.len(),
+            analyses,
+        );
+        assert_eq!(version, crate::storage::SCHEMA_VERSION, "{name}");
+        assert_eq!(tracks.len(), 5, "{name}");
+        assert!(titles.contains(&"Mayın Tarlası") && titles.iter().any(|t| t.contains("adsiz")), "{name}: {titles:?}");
+        assert_eq!(analyses, 3, "{name}: analizler silinmemeli");
+        assert_eq!(frames_ok, 3, "{name}: analiz içeriği bozulmamalı");
+        assert!(recovery.is_none(), "{name}");
+    }
+}
