+#[test]
+fn bver_sembolik_baglar() {
+    let real = dir_with(&[("gece-a.mp3", "a.mp3"), ("isik.flac", "alt/b.flac")]);
+    let other = dir_with(&[("isik.flac", "c.flac")]);
+    let link_root = real.parent().unwrap().join("kok-bag");
+    std::os::unix::fs::symlink(&real, &link_root).unwrap();
+    std::os::unix::fs::symlink(&other, real.join("baska-disk")).unwrap();
+    std::os::unix::fs::symlink(other.join("c.flac"), real.join("c-bag.flac")).unwrap();
+    let db = temp_path("library.sqlite3");
+    let library = Mutex::new(Library::open(&db).unwrap());
+    let folder = library.lock().unwrap().add_folder(&link_root.to_string_lossy()).unwrap();
+    let state = ScanState::default();
+    let summary = scan_folder(&library, &folder, &state).unwrap();
+    let paths: Vec<String> = library
+        .lock()
+        .unwrap()
+        .search("", 10)
+        .unwrap()
+        .into_iter()
+        .map(|t| t.path.replace(&*real.parent().unwrap().to_string_lossy(), "…"))
+        .collect();
+    println!(
+        "SEMBOLİK BAĞ: kök bağ üzerinden found={} unreadable={} updated={} → {paths:?} (bağlı alt klasör ve \
+         bağlı dosya sessizce atlandı)",
+        summary.found, summary.unreadable, summary.updated
+    );
+    assert_eq!(summary.found, 2, "kök bağ izlenir; alt klasör bağı ve dosya bağı izlenmez");
+    assert_eq!(summary.unreadable, 0, "atlanan bağ kullanıcıya bildirilmez");
+}
