+/// Dosyanın şema sayfası (sqlite_master/1. sayfa sonrası) bozuksa: hata göç içinde çıkar ve
+/// `LibraryError::Schema` olarak sarılır; `is_corruption` yalnızca `LibraryError::Database`'e bakar.
+#[test]
+fn bver_goc_icinde_yakalanan_bozulma_kenara_alinmaz() {
+    let db = temp_path("library.sqlite3");
+    {
+        let mut lib = Library::open(&db).unwrap();
+        let folder = lib.add_folder("/muzik").unwrap();
+        let stamp = FileStamp { size: 1, modified: 1 };
+        let upserts: Vec<_> = (0..300)
+            .map(|i| (track_info(&format!("/muzik/{i}.flac")), stamp))
+            .collect();
+        lib.apply_changes(folder.id, &upserts, &[]).unwrap();
+        lib.execute_for_test("PRAGMA wal_checkpoint(TRUNCATE)");
+    }
+    let _ = std::fs::remove_file(format!("{}-wal", db.display()));
+    let _ = std::fs::remove_file(format!("{}-shm", db.display()));
+    // 1. sayfanın 100 baytlık başlığı korunur, sayfanın geri kalanı (sqlite_master hücreleri) bozulur.
+    {
+        use std::io::{Seek, SeekFrom, Write};
+        let mut f = std::fs::File::options().write(true).open(&db).unwrap();
+        f.seek(SeekFrom::Start(100)).unwrap();
+        f.write_all(&vec![0xFFu8; 4096 - 100]).unwrap();
+    }
+    let opened = Library::open(&db);
+    let names: Vec<String> = std::fs::read_dir(db.parent().unwrap())
+        .unwrap()
+        .map(|e| e.unwrap().file_name().to_string_lossy().into_owned())
+        .collect();
+    println!(
+        "ŞEMA SAYFASI BOZUK: open → {:?}; kenara alındı mı: {}",
+        opened.as_ref().map(|l| l.recovery_notice().map(str::to_owned)).map_err(|e| e.to_string()),
+        names.iter().any(|n| n.contains(".bozuk-"))
+    );
+}
