+const CALISMA: &str = "/home/user/denetim-bagimsiz/calisma/B-VER";
+
+fn ses(name: &str) -> PathBuf {
+    Path::new(CALISMA).join("ses").join(name)
+}
+
+fn dir_with(files: &[(&str, &str)]) -> PathBuf {
+    let dir = temp_path("bver").with_extension("");
+    std::fs::create_dir_all(&dir).unwrap();
+    for (src, dst) in files {
+        let dst = dir.join(dst);
+        std::fs::create_dir_all(dst.parent().unwrap()).unwrap();
+        std::fs::copy(ses(src), dst).unwrap();
+    }
+    dir
+}
+
+fn count(conn: &rusqlite::Connection, sql: &str) -> i64 {
+    conn.query_row(sql, [], |r| r.get(0)).unwrap()
+}
+
+/// Kısa bir dosyayı gerçekten analiz edip saklanacak hâlini verir (stres ve boyut testleri).
+fn analyze_file(path: &Path) -> SavedAnalysis {
+    let target = Spectrogram::new();
+    spectrogram::analyze(Decoder::open(path).unwrap(), &target);
+    target.saved().unwrap()
+}
