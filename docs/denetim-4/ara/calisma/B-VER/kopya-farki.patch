+#[test]
+fn bver_klasor_icerigi_tamamen_degisince_hayaletler_ve_yanlis_mesaj() {
+    let dir = dir_with(&[("gece-a.mp3", "a.mp3"), ("isik.flac", "b.flac")]);
+    let db = temp_path("library.sqlite3");
+    let library = Mutex::new(Library::open(&db).unwrap());
+    let folder = library.lock().unwrap().add_folder(&dir.to_string_lossy()).unwrap();
+    let state = ScanState::default();
+    scan_folder(&library, &folder, &state).unwrap();
+    // Albüm yeniden ripplendi: eski iki dosya gitti, yeni adlı iki dosya geldi.
+    std::fs::remove_file(dir.join("a.mp3")).unwrap();
+    std::fs::remove_file(dir.join("b.flac")).unwrap();
+    std::fs::copy(ses("gece-a.mp3"), dir.join("01 Gece.mp3")).unwrap();
+    std::fs::copy(ses("isik.flac"), dir.join("02 Işık.flac")).unwrap();
+    let first = scan_folder(&library, &folder, &state).unwrap();
+    let after_first = library.lock().unwrap().track_count().unwrap();
+    let second = scan_folder(&library, &folder, &state).unwrap();
+    let after_second = library.lock().unwrap().track_count().unwrap();
+    println!(
+        "İÇERİK DEĞİŞTİ: 1. tarama found={} updated={} removed={} suspicious={} → listede {after_first} şarkı \
+         (2'si hayalet); 2. tarama removed={} → {after_second}",
+        first.found, first.updated, first.removed, first.suspicious, second.removed
+    );
+    assert_eq!(after_first, 4, "bir sonraki taramaya kadar iki hayalet kayıt");
+    assert_eq!(first.suspicious, 2, "\"hiçbiri bulunamadı\" denir, oysa 2 yeni dosya bulundu");
+    assert_eq!(after_second, 2);
+}
