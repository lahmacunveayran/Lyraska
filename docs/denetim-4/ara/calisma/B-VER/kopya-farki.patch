+#[test]
+fn bver_kok_gecici_yokken_sonra_geri_gelince() {
+    let dir = dir_with(&[("gece-a.mp3", "a.mp3"), ("isik.flac", "b.flac")]);
+    let db = temp_path("library.sqlite3");
+    let library = Mutex::new(Library::open(&db).unwrap());
+    let folder = library.lock().unwrap().add_folder(&dir.to_string_lossy()).unwrap();
+    let state = ScanState::default();
+    scan_folder(&library, &folder, &state).unwrap();
+    let aside = dir.with_extension("aside");
+    std::fs::rename(&dir, &aside).unwrap();
+    let gone = scan_folder(&library, &folder, &state);
+    let during = library.lock().unwrap().track_count().unwrap();
+    std::fs::rename(&aside, &dir).unwrap();
+    let back = scan_folder(&library, &folder, &state).unwrap();
+    println!(
+        "KÖK YOK: sonuç {:?}; şarkılar kaldı {during}; geri gelince unchanged={} updated={}",
+        gone.as_ref().map(|_| ()).map_err(|e| e.to_string()),
+        back.unchanged,
+        back.updated
+    );
+    assert!(gone.is_err());
+    assert_eq!(during, 2);
+    assert_eq!(back.unchanged, 2);
+}
