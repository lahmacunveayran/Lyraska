+// ---------------------------------------------------------------- 2. Çökme tutarlılığı: içten bozuk dosya
+
+/// Başlığı sağlam ama iç sayfaları bozuk dosya (yarım yazılmış sayfa, bozuk sektör): "bozuk
+/// dosya kenara alınır" vaadi yalnızca `PRAGMA journal_mode` aşamasında yakalanan hataları kapsar.
+#[test]
+fn bver_icten_bozuk_dosya_kenara_alinmaz() {
+    let db = temp_path("library.sqlite3");
+    {
+        let mut lib = Library::open(&db).unwrap();
+        let folder = lib.add_folder("/muzik").unwrap();
+        let stamp = FileStamp { size: 1, modified: 1 };
+        let upserts: Vec<_> = (0..3000)
+            .map(|i| {
+                let mut info = track_info(&format!("/muzik/{i}.flac"));
+                info.title = Some(format!("Şarkı {i}"));
+                (info, stamp)
+            })
+            .collect();
+        lib.apply_changes(folder.id, &upserts, &[]).unwrap();
+        lib.execute_for_test("PRAGMA wal_checkpoint(TRUNCATE)");
+    }
+    let _ = std::fs::remove_file(format!("{}-wal", db.display()));
+    let _ = std::fs::remove_file(format!("{}-shm", db.display()));
+    // Dosyanın ortasındaki sayfalar (tracks B-ağacı) çöple dolduruldu; başlık ve sqlite_master sağlam.
+    let size = std::fs::metadata(&db).unwrap().len();
+    {
+        use std::io::{Seek, SeekFrom, Write};
+        let mut f = std::fs::File::options().write(true).open(&db).unwrap();
+        f.seek(SeekFrom::Start(size / 3)).unwrap();
+        f.write_all(&vec![0xA5u8; (size / 3) as usize]).unwrap();
+    }
+    let opened = Library::open(&db);
+    let names: Vec<String> = std::fs::read_dir(db.parent().unwrap())
+        .unwrap()
+        .map(|e| e.unwrap().file_name().to_string_lossy().into_owned())
+        .collect();
+    match &opened {
+        Ok(lib) => {
+            let status = lib.track_count().map(|n| n.to_string()).unwrap_or_else(|e| e.to_string());
+            let search = lib.search("", 10).map(|t| t.len().to_string()).unwrap_or_else(|e| e.to_string());
+            let search_w = lib.search("şarkı", 10).map(|t| t.len().to_string()).unwrap_or_else(|e| e.to_string());
+            println!(
+                "İÇTEN BOZUK: open OK, kurtarma notu {:?}; track_count → {status}; search('') → {search}; \
+                 search('şarkı') → {search_w}; klasördeki dosyalar {names:?}",
+                lib.recovery_notice()
+            );
+            assert!(lib.recovery_notice().is_none(), "kenara alınmadı");
+        }
+        Err(e) => println!("İÇTEN BOZUK: open HATA {e}; klasördeki dosyalar {names:?}"),
+    }
+    // İkinci açılış da aynı: program her açılışta aynı hatayı verir.
+    let again = Library::open(&db);
+    println!(
+        "İÇTEN BOZUK: ikinci açılış {:?}",
+        again.as_ref().map(|l| l.search("", 10).map(|t| t.len()).map_err(|e| e.to_string())).map_err(|e| e.to_string())
+    );
+    assert!(!names.iter().any(|n| n.contains(".bozuk-")), "bozuk dosya kenara alınmadı: {names:?}");
+}
